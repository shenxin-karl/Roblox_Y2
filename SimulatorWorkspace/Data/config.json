          "kind": "Power",
          "base": 0,
          "multiplier": { "kind": "constant", "value": 25 },
          "power": { "kind": "constant", "value": 1 },
          "rounding": "floor"
        }
      },
      {
        "key": "levelMultiplier",
        "formula": {
          "kind": "Power",
          "base": 0.5,
          "multiplier": { "kind": "constant", "value": 0.5 },
          "power": { "kind": "constant", "value": 1 },
          "rounding": "none"
        }
      }
    ],
    "editor": {
      "displayName": "武器升级曲线",
      "display": {
        "kind": "curve",
        "xLabel": "武器当前等级",
