              { "fromInput": 5, "toInput": 5, "fromValue": 288, "toValue": 288 },
              { "fromInput": 6, "toInput": 6, "fromValue": 588, "toValue": 588 },
              { "fromInput": 7, "toInput": 7, "fromValue": 1188, "toValue": 1188 },
              { "fromInput": 8, "toInput": 8, "fromValue": 2688, "toValue": 2688 },
              { "fromInput": 9, "toInput": 9, "fromValue": 5688, "toValue": 5688 },
              { "fromInput": 10, "toInput": 10, "fromValue": 12888, "toValue": 12888 },
              { "fromInput": 11, "toInput": 11, "fromValue": 28888, "toValue": 28888 }
