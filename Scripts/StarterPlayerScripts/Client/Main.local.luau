local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
require(ReplicatedStorage:WaitForChild("Scripts"):WaitForChild("GameInit"))
local FX, FC = _G.FX, _G.FC
local FXLoader = FX.Loader
local PlayerClass = require(script.Parent.Player.CPlayerObjectClass)
FXLoader:Require(script.Parent, "Player.CBaseCompClass")
FXLoader:Require(script.Parent, "Player.CForgeCompClass")
FXLoader:Require(script.Parent, "Player.CSlotSwordCompClass")
FXLoader:Require(script.Parent, "Player.CMiningCompClass")
FXLoader:Require(script.Parent, "Player.CBaseOwnerMarkerCompClass")
FXLoader:Require(script.Parent, "UI.CMainUICompClass")
FXLoader:Require(script.Parent, "UI.CUpgradeWorkshopUICompClass")
FXLoader:Require(script.Parent, "UI.CCommonUICompClass")
FXLoader:Require(script.Parent, "UI.CWeaponActionsCompClass")
FXLoader:Require(script.Parent, "UI.COfflineIncomeUICompClass")
FXLoader:Require(script.Parent, "UI.CCurrencyShopUICompClass")
FXLoader:Require(script.Parent, "UI.CMoneyMultiplierUICompClass")
FXLoader:Require(script.Parent, "UI.CWelfareUICompClass")
FXLoader:Require(script.Parent, "UI.CLeaderboardUICompClass")
FXLoader:Require(script.Parent, "UI.CInventoryCompClass")
FXLoader:Require(script.Parent, "UI.CWeaponMutationCompClass")
local isDeveloper = FX.IsDeveloper(Players.LocalPlayer.UserId)
if isDeveloper then
    FXLoader:Require(script.Parent, "UI.CGMPanelUICompClass")
end

FC.PlayerObject = PlayerClass.New(Players.LocalPlayer.UserId)

-- 在此添加项目客户端组件；UI 子类提供自己的原生节点和模板。
FC.PlayerObject:AddComponent("CBaseCompClass")
FC.PlayerObject:AddComponent("CForgeCompClass")
FC.PlayerObject:AddComponent("CSlotSwordCompClass")
FC.PlayerObject:AddComponent("CMiningCompClass")
FC.PlayerObject:AddComponent("CBaseOwnerMarkerCompClass")
FC.PlayerObject:AddComponent("CMainUICompClass")
FC.PlayerObject:AddComponent("CUpgradeWorkshopUICompClass")
FC.PlayerObject:AddComponent("CCommonUICompClass")
FC.PlayerObject:AddComponent("CWeaponActionsCompClass")
FC.PlayerObject:AddComponent("COfflineIncomeUICompClass")
FC.PlayerObject:AddComponent("CCurrencyShopUICompClass")
FC.PlayerObject:AddComponent("CMoneyMultiplierUICompClass")
FC.PlayerObject:AddComponent("CWelfareUICompClass")
FC.PlayerObject:AddComponent("CLeaderboardUICompClass")
FC.PlayerObject:AddComponent("CWeaponMutationCompClass")
FC.PlayerObject:AddComponent("CInventoryCompClass")
if isDeveloper then
    FC.PlayerObject:AddComponent("CGMPanelUICompClass")
end
FC.WaitServerReady()
