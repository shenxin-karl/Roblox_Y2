-- 货币商店展示由导出 View 管理；平台收据是 Robux 商品的到账依据。
local MarketplaceService = game:GetService("MarketplaceService")
local FX, FC = _G.FX, _G.FC
local Loader = FX.Loader
local Text = FX.Text
local Fields = _G.PlayerDataConfig
local Utility = Loader:RequireShared("Scripts.Game.Shared.GameUtility")
local Rules = Loader:RequireShared("Scripts.Game.Shared.MoneyMultiplierRules")
local ShopConfig = Loader:RequireShared("Scripts.Game.Configs.ShopConfig")
local Goods = _G.GoodsConfig.GoodsData
Loader:RequireFromParent(script, "Generated.CCurrencyShopView")
local Component = FX.Class("CCurrencyShopUICompClass", "CCurrencyShopView")
local TranslationTexts = Text.Define("Y2CurrencyShop", {
    Multiplier = "Money Multiplier ×{rate}",
    MultiplierDescription = "Multiply cash generated by displayed swords, including offline income.",
    Maxed = "Your money multiplier has reached ×256.",
})
local CardStyles = {[101] = "Cyan", [102] = "Orange", [103] = "Gold", [111] = "Green", [112] = "Purple"}

--- 绑定导出界面与权威档位；平台完成事件仅恢复购买按钮。
function Component:OnReady()
    Component.Super.OnReady(self)
    self.Config = {products = {}}
    self.State = {tab = "Robux", open = false}
    self:Hide()
    self:WatchDataChanged(Fields.PaidMultiplierTier, function()
        self:UpdateProducts()
    end)
    self:TrackConnection(FC.Localization.Changed:Connect(function()
        self:UpdateProducts()
    end))
    self:TrackConnection(MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId, productId)
        if userId == self:GetPlayerNode().UserId and productId == self._promptProductId then
            self:ClearPurchase()
        end
    end))
end

--- 根据档位与商品映射构建稳定列表；没有平台 ID 的商品不可点击。
function Component:UpdateProducts()
    local tier = self:GetNumber(Fields.PaidMultiplierTier)
    local price = Rules.GetNextPrice(tier)
    local rate = Rules.GetMultiplier(price and tier + 1 or tier)
    local products = {{
        id = "money_multiplier",
        currency = "Diamond",
        title = "",
        titleText = Text.Tr(TranslationTexts.Multiplier, {rate = Utility.NumberToText(rate)}),
        description = "",
        descriptionText = Text.Tr(TranslationTexts.MultiplierDescription),
        price = price or 0,
        soldOut = price == nil,
        allowSoldOutAction = true,
        unavailable = not table.find(_G.NetworkProtocol.ClientMsgID, "C2S_BuyMoneyMultiplier"),
        cardStyle = "Orange",
    }}
    for index, entry in ipairs(ShopConfig.MiniCoinData) do
        local goods = Goods[entry.DevGoodsId]
        local productId = goods.RobloxProductId
        table.insert(products, {
            id = tostring(entry.DevGoodsId),
            currency = "Robux",
            title = goods.Name,
            description = goods.Desc,
            icon = entry.IconId,
            price = goods.Price,
            unavailable = type(productId) ~= "number" or productId <= 0 or productId % 1 ~= 0,
            productId = productId,
            cardStyle = CardStyles[entry.DevGoodsId],
        })
    end
    self.Config.products = products
    self:RefreshUI()
end

--- 按业务目标定位页签；缺钻统一打开包含钻石礼包的 Robux 页。
--- @param tab string View 定义的 Diamond 或 Robux。
--- @return boolean 界面是否就绪并已接受打开请求。
function Component:OpenTab(tab)
    if not self.State then
        return false
    end
    self.State.tab = tab
    self.State.open = true
    self.List.CanvasPosition = Vector2.zero
    self:Show()
    return true
end

--- 记录关闭状态，后续数据同步不会重新打开窗口。
function Component:OnHide()
    self.State.open = false
end

--- 恢复购买按钮和卡片，发货仍由服务端处理。
function Component:ClearPurchase()
    self._promptProductId = nil
    self.State.busy = false
    self.State.pending = nil
    self:RefreshUI()
end

--- 复用项目统一价格格式。
--- @param amount number 未格式化价格。
--- @return string 格式化后的价格。
function Component:FormatNumber(amount)
    return Utility.NumberToText(amount)
end

--- 转发界面动作；Robux 预检和平台弹窗复用通用 UI。
--- @param action string SelectTab、Close 或 Purchase。
--- @param payload table View 提供的页签或商品业务 ID。
function Component:OnUIAction(action, payload)
    if action == "Close" then
        self:Hide()
        return
    end
    if action == "SelectTab" then
        self.State.tab = payload.tab
        self.List.CanvasPosition = Vector2.zero
        self:RefreshUI()
        return
    end
    if action ~= "Purchase" or self.State.busy then
        return
    end
    local commonUI = self:GetOwner():RequireComponent("CCommonUICompClass")
    for index, product in ipairs(self.Config.products) do
        if product.id ~= payload.productId or product.unavailable then
            continue
        end
        if product.currency == "Diamond" then
            if product.soldOut then
                commonUI:ShowLocalizedTips(TranslationTexts.Maxed)
            else
                self:Hide()
                self:GetOwner():RequireComponent("CMoneyMultiplierUICompClass"):OpenPurchase()
            end
            return
        end
        self.State.busy = true
        self.State.pending = {[product.id] = true}
        self._promptProductId = product.productId
        self:RefreshUI()
        self._purchaseTask = task.defer(function()
            local ok, prompted = pcall(commonUI.ShowDeveloperBuyUI, commonUI, product.productId)
            self._purchaseTask = nil
            if not ok or not prompted then
                self:ClearPurchase()
                commonUI:ShowLocalizedTips(self.BaseViewTranslationTexts.Unavailable)
            end
        end)
        return
    end
end

--- 取消组件自己的预检任务，父类释放按钮订阅。
function Component:Dtor()
    if self._purchaseTask then
        task.cancel(self._purchaseTask)
    end
    Component.Super.Dtor(self)
end

return Component
