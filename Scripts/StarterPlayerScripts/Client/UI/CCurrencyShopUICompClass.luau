-- 货币商店展示由导出 View 管理；平台收据是 Robux 商品的到账依据。
local MarketplaceService = game:GetService("MarketplaceService")
local RunService = game:GetService("RunService")
local FX, FC = _G.FX, _G.FC
local Loader = FX.Loader
local Text = FX.Text
local Fields = _G.PlayerDataConfig
local Utility = Loader:RequireShared("Scripts.Game.Shared.GameUtility")
local Rules = Loader:RequireShared("Scripts.Game.Shared.MoneyMultiplierRules")
local ShopConfig = Loader:RequireShared("Scripts.Game.Configs.ShopConfig")
local DiamondPurchase = Loader:RequireFromParent(script, "CDiamondPurchase")
local Goods = _G.GoodsConfig.GoodsData
local CollectAllGoods = _G.GoodsConfig.GemGoodsData[201]
local CollectAllId = tostring(CollectAllGoods.GemGoodsId)
local CollectAllIcon = "rbxassetid://78260013805626"
Loader:RequireFromParent(script, "Generated.CCurrencyShopView")
local Component = FX.Class("CCurrencyShopUICompClass", "CCurrencyShopView")
local TranslationTexts = Text.Define("Y2CurrencyShop", {
    Multiplier = "Money Multiplier ×{rate}",
    MultiplierDescription = "Multiply cash generated by displayed swords, including offline income.",
    Maxed = "Your money multiplier has reached ×256.",
    CollectAll = "Collect All Base Earnings",
    CollectAllCategory = "BASE PRIVILEGE",
    CollectAllUnlocked = "Unlocked. Claim all pending online cash in your base for free.",
    CollectAllReceived = "Collected {value} cash from your base.",
    CollectAllEmpty = "There are no base earnings to collect yet.",
    CollectAllFailed = "Couldn't collect base earnings. Please try again.",
})
local CardStyles = {[101] = "Cyan", [102] = "Orange", [103] = "Gold", [111] = "Green", [112] = "Purple"}

--- 绑定导出界面与权威档位；平台完成事件仅恢复购买按钮。
function Component:OnReady()
    Component.Super.OnReady(self)
    self.Config = {products = {}}
    self.State = {tab = "Robux", open = false}
    self:Hide()
    self:WatchDataChanged(Fields.PaidMultiplierTier, function()
        self:UpdateProducts()
    end)
    self:WatchDataChanged(Fields.CollectAllIncomeUnlocked, function()
        self:UpdateProducts()
    end)
    self:TrackConnection(FC.Localization.Changed:Connect(function()
        self:UpdateProducts()
    end))
    self:TrackConnection(MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId, productId, purchased)
        if userId == self:GetPlayerNode().UserId and productId == self._promptProductId then
            if not purchased then
                FX.Network:SendMsgToServer("C2S_CommerceAnalytics", "Canceled", productId, "CurrencyShop")
                self._seenProducts[productId] = nil
            end
            self:ClearPurchase()
        end
    end))
    self._seenProducts = {}
    local elapsed = 0
    --- 每次打开期间只记录实际进入可见列表的报价。
    --- @param dt number 距上一帧的秒数。
    self:TrackConnection(RunService.Heartbeat:Connect(function(dt)
        if not self.State.open or self.State.tab ~= "Robux" then
            return
        end
        elapsed += dt
        if elapsed >= 0.25 then
            elapsed = 0
            self:ObserveQuotes()
        end
    end))
end

--- 仅使用 View 已渲染的卡片位置统计曝光，不接管列表布局。
function Component:ObserveQuotes()
    local top = self.List.AbsolutePosition.Y
    local bottom = top + self.List.AbsoluteWindowSize.Y
    for index, product in ipairs(self.Config.products) do
        local card = self.Cards[product.id]
        local id = product.productId
        if product.currency == "Robux" and not product.unavailable and card and not self._seenProducts[id]
            and card.button.AbsolutePosition.Y < bottom
            and card.button.AbsolutePosition.Y + card.button.AbsoluteSize.Y > top then
            self._seenProducts[id] = true
            FX.Network:SendMsgToServer("C2S_CommerceAnalytics", "Seen", id, "CurrencyShop")
        end
    end
end

--- 根据档位与商品映射构建稳定列表；没有平台 ID 的商品不可点击。
function Component:UpdateProducts()
    local tier = self:GetNumber(Fields.PaidMultiplierTier)
    local price = Rules.GetNextPrice(tier)
    local rate = Rules.GetMultiplier(price and tier + 1 or tier)
    local collectUnlocked = self:GetFlag(Fields.CollectAllIncomeUnlocked)
    local products = {{
        id = "money_multiplier",
        currency = "Diamond",
        title = "",
        titleText = Text.Tr(TranslationTexts.Multiplier, {rate = Utility.NumberToText(rate)}),
        description = "",
        descriptionText = Text.Tr(TranslationTexts.MultiplierDescription),
        price = price or 0,
        soldOut = price == nil,
        allowSoldOutAction = true,
        unavailable = not table.find(_G.NetworkProtocol.ClientMsgID, "C2S_BuyMoneyMultiplier"),
        cardStyle = "Orange",
    }, {
        id = CollectAllId,
        currency = "Diamond",
        icon = CollectAllIcon,
        title = TranslationTexts.CollectAll.Source,
        description = collectUnlocked and TranslationTexts.CollectAllUnlocked.Source or CollectAllGoods.Desc,
        price = collectUnlocked and 0 or CollectAllGoods.Price,
    }}
    for index, entry in ipairs(ShopConfig.MiniCoinData) do
        local goods = Goods[entry.DevGoodsId]
        local productId = goods.RobloxProductId
        table.insert(products, {
            id = tostring(entry.DevGoodsId),
            currency = "Robux",
            title = goods.Name,
            description = goods.Desc,
            icon = entry.IconId,
            price = goods.Price,
            unavailable = type(productId) ~= "number" or productId <= 0 or productId % 1 ~= 0,
            productId = productId,
            cardStyle = CardStyles[entry.DevGoodsId],
        })
    end
    self.Config.products = products
    self:RefreshUI()
end

--- 按业务目标定位页签；缺钻统一打开包含钻石礼包的 Robux 页。
--- @param tab string View 定义的 Diamond 或 Robux。
--- @return boolean 界面是否就绪并已接受打开请求。
function Component:OpenTab(tab)
    if not self.State then
        return false
    end
    self.State.tab = tab
    self.State.open = true
    self.List.CanvasPosition = Vector2.zero
    self:Show()
    return true
end

--- 记录关闭状态，后续数据同步不会重新打开窗口。
function Component:OnHide()
    self.State.open = false
    self._seenProducts = {}
end

--- 恢复购买按钮和卡片，发货仍由服务端处理。
function Component:ClearPurchase()
    self._promptProductId = nil
    self.State.busy = false
    self.State.pending = nil
    self:RefreshUI()
end

--- 复用项目统一价格格式。
--- @param amount number 未格式化价格。
--- @return string 格式化后的价格。
function Component:FormatNumber(amount)
    return Utility.NumberToText(amount)
end

--- 仅未解锁时打开付费确认；已拥有特权直接免费领取。
function Component:OpenCollectAll()
    local commonUI = self:GetOwner():RequireComponent("CCommonUICompClass")
    if not self:GetFlag(Fields.CollectAllIncomeUnlocked) then
        DiamondPurchase.Confirm({
            itemId = CollectAllId,
            name = TranslationTexts.CollectAll.Source,
            category = TranslationTexts.CollectAllCategory.Source,
            description = CollectAllGoods.Desc,
            price = CollectAllGoods.Price,
            icon = CollectAllIcon,
        }, function()
            local result, amount = FX.Network:InvokeServer("C2S_CollectAllIncome", true)
            if result == "Purchased" and amount > 0 then
                commonUI:ShowLocalizedTips(TranslationTexts.CollectAllReceived, {value = Utility.NumberToText(amount)})
            end
            return result
        end)
        return
    end

    self.State.busy = true
    self.State.pending = {[CollectAllId] = true}
    self:RefreshUI()
    self._purchaseTask = task.defer(function()
        local ok, result, amount = pcall(FX.Network.InvokeServer, FX.Network, "C2S_CollectAllIncome", false)
        self._purchaseTask = nil
        self:ClearPurchase()
        if ok and result == "Claimed" then
            commonUI:ShowLocalizedTips(TranslationTexts.CollectAllReceived, {value = Utility.NumberToText(amount)})
        elseif ok and result == "Empty" then
            commonUI:ShowLocalizedTips(TranslationTexts.CollectAllEmpty)
        else
            commonUI:ShowLocalizedTips(TranslationTexts.CollectAllFailed)
        end
    end)
end

--- 转发界面动作；Robux 预检和平台弹窗复用通用 UI。
--- @param action string SelectTab、Close 或 Purchase。
--- @param payload table View 提供的页签或商品业务 ID。
function Component:OnUIAction(action, payload)
    if action == "Close" then
        self:Hide()
        return
    end
    if action == "SelectTab" then
        self.State.tab = payload.tab
        self.List.CanvasPosition = Vector2.zero
        self:RefreshUI()
        return
    end
    if action ~= "Purchase" or self.State.busy then
        return
    end
    local commonUI = self:GetOwner():RequireComponent("CCommonUICompClass")
    for index, product in ipairs(self.Config.products) do
        if product.id ~= payload.productId or product.unavailable then
            continue
        end
        if product.currency == "Diamond" then
            if product.id == CollectAllId then
                self:OpenCollectAll()
            elseif product.soldOut then
                commonUI:ShowLocalizedTips(TranslationTexts.Maxed)
            else
                self:Hide()
                self:GetOwner():RequireComponent("CMoneyMultiplierUICompClass"):OpenPurchase("CurrencyShop")
            end
            return
        end
        self.State.busy = true
        self.State.pending = {[product.id] = true}
        self._promptProductId = product.productId
        self:RefreshUI()
        FX.Network:SendMsgToServer("C2S_CommerceAnalytics", "Seen", product.productId, "CurrencyShop")
        FX.Network:SendMsgToServer("C2S_CommerceAnalytics", "Request", product.productId, "CurrencyShop")
        self._purchaseTask = task.defer(function()
            local ok, prompted = pcall(commonUI.ShowDeveloperBuyUI, commonUI, product.productId)
            self._purchaseTask = nil
            if not ok or not prompted then
                FX.Network:SendMsgToServer("C2S_CommerceAnalytics", "PromptFailed", product.productId, "CurrencyShop")
                self._seenProducts[product.productId] = nil
                self:ClearPurchase()
                commonUI:ShowLocalizedTips(self.BaseViewTranslationTexts.Unavailable)
            end
        end)
        return
    end
end

--- 取消组件自己的预检任务，父类释放按钮订阅。
function Component:Dtor()
    if self._purchaseTask then
        task.cancel(self._purchaseTask)
    end
    Component.Super.Dtor(self)
end

return Component
